{
  "name": "udyog-mitra",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "udyog-mitra-db",
      "database_id": "d83a50cf-1048-4608-9567-97cba13bbd71",
      "migrations_dir": "db/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "RESUMES",
      "bucket_name": "udyog-mitra-resumes"
    }
  ]
}